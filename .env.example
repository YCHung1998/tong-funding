# ==========================================================================================
# tong-funding 金鑰匯入範本 / credentials import template
#
# 這個檔案只放「佔位值」。請複製成 .env（或 .env-demo / .env-real）再填入真值。
# This file holds placeholders only. Copy it to .env (or .env-demo / .env-real) and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# 絕對不要 commit、不要貼到對話或截圖。.gitignore 已忽略 .env*（.env.example 除外）。
# Never commit it, never paste it into chats or screenshots. `.env*` is git-ignored.
# ==========================================================================================
#
# ---- 用法 A：同一個檔案，兩個區塊 / Style A: one file, two blocks --------------------------
#   cargo run -p tong-funding -- secrets import-env .env            # 只讀 DEMO_ 區塊 → demo 鑰匙圈
#   cargo run -p tong-funding -- secrets import-env --live .env     # 只讀 LIVE_ 區塊 → live 鑰匙圈
#   cargo run -p tong-funding -- secrets status                     # 只顯示 present / missing
#   cargo run -p tong-funding -- secrets status --live
#
# ---- 用法 B：兩個檔案 / Style B: two files --------------------------------------------------
#   .env-demo：填下面的 DEMO_ 區塊（或無前綴舊名稱 BINANCE_API_KEY …）
#   .env-real：填下面的 LIVE_ 區塊（或無前綴舊名稱，但「必須」加 --live 匯入）
#   cargo run -p tong-funding -- secrets import-env .env-demo
#   cargo run -p tong-funding -- secrets import-env --live .env-real
#   ※ 無前綴名稱跟著你選的身分走；不確定就用 DEMO_ / LIVE_ 前綴，不會寫錯格。
#     Unprefixed names follow the identity you pick; use the prefixes when in doubt.
#
# 規則 / Rules
#   - 不帶 --live 時只讀 DEMO_* 與無前綴名稱，LIVE_* 一律略過；帶 --live 則相反。
#   - 同一個秘密的兩個名稱值不同 → 整批拒絕、什麼都不寫。
#   - live 的值如果和 demo 鑰匙圈裡的相同（貼錯 demo 金鑰）→ 整批拒絕。
#   - live 不支援 OKX；LIVE_OKX_* 會被拒絕。
#   - 空值會被略過；BASE_URL 等其他變數會被忽略；匯入過程不會印出任何值。
#   - 匯入完成後建議刪除這個檔案（鑰匙圈已有一份）。
# ==========================================================================================

# ------------------------------------------------------------------------------------------
# DEMO / TESTNET 金鑰（Binance demo.binance.com、Bybit Demo Trading、OKX demo）
# 只放測試網金鑰，不涉及真錢 / testnet keys only, no real money
# ------------------------------------------------------------------------------------------
DEMO_BINANCE_API_KEY=your_demo_binance_api_key
DEMO_BINANCE_API_SECRET=your_demo_binance_api_secret
DEMO_BYBIT_API_KEY=your_demo_bybit_api_key
DEMO_BYBIT_API_SECRET=your_demo_bybit_api_secret
DEMO_OKX_API_KEY=your_demo_okx_api_key
DEMO_OKX_API_SECRET=your_demo_okx_api_secret
DEMO_OKX_PASSPHRASE=your_demo_okx_passphrase

# ------------------------------------------------------------------------------------------
# LIVE（真錢）金鑰 / REAL-MONEY keys
# 只用「專用子帳戶」的金鑰：只開合約交易、關閉提領、設定 IP 白名單。live 不支援 OKX。
# Dedicated sub-account keys only: futures trading on, withdrawals OFF, IP whitelist set.
# ------------------------------------------------------------------------------------------
LIVE_BINANCE_API_KEY=your_live_binance_api_key
LIVE_BINANCE_API_SECRET=your_live_binance_api_secret
LIVE_BYBIT_API_KEY=your_live_bybit_api_key
LIVE_BYBIT_API_SECRET=your_live_bybit_api_secret
